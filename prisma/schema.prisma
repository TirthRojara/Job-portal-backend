// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}

model User {
  id               Int               @id @default(autoincrement())
  name             String?
  email            String            @unique
  password         String
  role             Role              @default(CANDIDATE)
  status           Boolean           @default(true)
  candidateProfile CandidateProfile?
  Company          Company[]
  Job              Job[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model CandidateProfile {
  id         Int      @id @default(autoincrement())
  fullName   String
  gender     Gender
  phone      String   @unique
  cv         String
  birthDate  DateTime @db.Date
  address    String
  openToWork Boolean  @default(false)
  status     Boolean  @default(true)

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  CandidateLanguage   CandidateLanguage[]
  CandidateEducation  CandidateEducation[]
  CandidateSkill      CandidateSkill[]
  CandidateExperience CandidateExperience[]
  Apply               Apply[]
}

model Language {
  name String @id

  CandidateLanguage CandidateLanguage[]
}

enum Level {
  NATIVE
  FLUENT
  BASIC
}

model CandidateLanguage {
  level              Level            @default(BASIC)
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  candidateProfileId Int
  language           Language         @relation(fields: [languageName], references: [name])
  languageName       String

  @@unique([candidateProfileId, languageName])
}

model Education {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  map                String
  CandidateEducation CandidateEducation[]
}

enum Degree {
  BACHELOR
  MASTER
  PHD
}

model CandidateEducation {
  major              String
  degree             Degree           @default(BACHELOR)
  yearStart          Int
  yearEnd            Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  candidateProfileId Int
  education          Education        @relation(fields: [educationId], references: [id])
  educationId        Int

  @@id([candidateProfileId, educationId])
}

model Skill {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  CandidateSkill CandidateSkill[]
  JobSkill       JobSkill[]
}

model CandidateSkill {
  id                 Int              @id @default(autoincrement())
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  candidateProfileId Int
  skill              Skill            @relation(fields: [skillId], references: [id])
  skillId            Int

  @@unique([candidateProfileId, skillId])
}

enum WorkPlace {
  ONSITE
  REMOTE
  HYBRID
}

model CandidateExperience {
  id               Int       @id @default(autoincrement())
  companyName      String
  department       String
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  position         String
  description      String
  currentlyWorking Boolean   @default(false)
  workPlace        WorkPlace @default(ONSITE)
  location         String

  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  candidateProfileId Int

  @@unique([id, candidateProfileId])
}

enum TeamSizeRange {
  ZERO_TO_ONE
  TWO_TO_TEN
  ELEVEN_TO_FIFTY
  FIFTY_ONE_TO_TWO_HUNDRED
  TWO_HUNDRED_ONE_TO_FIVE_HUNDRED
  FIVE_HUNDRED_ONE_TO_ONE_THOUSAND
  OVER_ONE_THOUSAND
}

model Company {
  id              Int            @id @default(autoincrement())
  name            String
  description     String
  location        String
  address         String?
  mapLink         String?
  websiteUrl      String?
  teamSizeLabel   TeamSizeRange?
  totalEmployees  Int
  establishedDate DateTime
  isApproved      Boolean        @default(false)
  views           Int?           @default(0)

  user   User @relation(fields: [userId], references: [id])
  userId Int

  CompanyImage    CompanyImage[]
  CompanyIndustry CompanyIndustry[]
  Job             Job[]
}

model CompanyImage {
  id       Int    @id @default(autoincrement())
  imageUrl String

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int
}

model Industry {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  CompanyIndustry CompanyIndustry[]
}

model CompanyIndustry {
  id Int @id @default(autoincrement())

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  industry   Industry @relation(fields: [industryId], references: [id])
  industryId Int

  @@unique([companyId, industryId])
}

model JobRole {
  id   Int    @id @default(autoincrement())
  name String @unique
  Job  Job[]
}

enum JobStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
}

model Job {
  id                  Int       @id @default(autoincrement())
  title               String
  description         String
  responsibilities    String
  requirements        String
  location            String
  workplace           WorkPlace
  status              JobStatus
  salaryMin           Int
  salaryMax           Int
  postedAt            DateTime  @default(now()) @db.Timestamp
  applicationDeadline DateTime  @db.Date
  updateAt            DateTime? @updatedAt
  totalview           Int       @default(0)
  isDeleted           Boolean   @default(false)

  company   Company @relation(fields: [companyId], references: [id])
  companyId Int

  postBy   User @relation(fields: [postById], references: [id])
  postById Int

  jobRole   JobRole @relation(fields: [jobRoleId], references: [id])
  jobRoleId Int

  JobSkill   JobSkill[]
  JobBenefit JobBenefit[]
  Apply      Apply[]
}

model JobSkill {
  job   Job @relation(fields: [jobId], references: [id])
  jobId Int

  skill   Skill @relation(fields: [skillId], references: [id])
  skillId Int

  @@id([jobId, skillId])
}

model Benefit {
  name       String       @id
  JobBenefit JobBenefit[]
}

model JobBenefit {
  job   Job @relation(fields: [jobId], references: [id])
  jobId Int

  benefit     Benefit @relation(fields: [benefitName], references: [name])
  benefitName String

  @@id([jobId, benefitName])
}

enum ApplyStatus {
  PENDING
  VIEWED
  SELECTED
  NOTSELECT
  INTOUCH
}

model Apply {
  applyDate DateTime    @default(now()) @db.Timestamp
  status    ApplyStatus @default(PENDING)

  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  candidateProfileId Int

  job   Job @relation(fields: [jobId], references: [id])
  jobId Int

  @@id([candidateProfileId, jobId])
}
