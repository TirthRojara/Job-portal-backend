enum RecruiterPackageStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model RecruiterPackage {
  id        Int       @id @default(autoincrement())
  startDate DateTime  @default(now())
  endDate   DateTime? @db.Date

  razorpaySubscriptionId String?                @unique
  status                 RecruiterPackageStatus
  billingCycleCount      Int?                   @default(0)

  User   User @relation(fields: [userId], references: [id])
  userId Int  @unique

  package   Package @relation(fields: [packageId], references: [id])
  packageId Int
}

enum SubscriptionStatus {
  CREATED
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  HALTED
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  razorpaySubscriptionId String             @unique
  razorpayPlanId         String
  status                 SubscriptionStatus
  startAt                DateTime? // Subscription start date
  endAt                  DateTime? // Optional end date, if defined
  totalCount             Int? // Total billing cycles count, null for infinite
  paidCount              Int? // Count of paid cycles so far
  currency               String             @default("INR")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  recruiter   User @relation(fields: [recruiterId], references: [id])
  recruiterId Int

  package   Package @relation(fields: [packageId], references: [id])
  packageId Int
}

enum PaymentStatus {
  SUCCESSFUL
  FAILED
  REFUNDED
}

model PaymentHistory {
  id                     Int           @id @default(autoincrement())
  razorpayPaymentId      String?       @unique
  razorpaySubscriptionId String?
  amount                 Float
  currency               String        @default("INR")
  status                 PaymentStatus
  paymentMethod          String?
  failureReason          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user   User @relation(fields: [userId], references: [id])
  userId Int
}
