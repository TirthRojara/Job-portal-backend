generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // url       = env("DATABASE_URL") // pooled (6543)
  // directUrl = env("DIRECT_URL") // direct (5432)
}

model User {
  id                     Int                     @id @default(autoincrement())
  name                   String
  email                  String                  @unique
  password               String?
  role                   Role                    @default(CANDIDATE)
  isVerified             Boolean                 @default(false)
  authType               AuthType                @default(EMAIL)
  ProviderAuthId         String?
  authOTPs               AuthOTP?
  candidateProfile       CandidateProfile?
  checkLimitForRecruiter CheckLimitForRecruiter?
  Company                Company[]
  Job                    Job[]
  PaymentHistory         PaymentHistory[]
  RecruiterPackage       RecruiterPackage?
  accessTokens           RefreshToken[]
  Subscription           Subscription[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token, userId])
  @@index([expiresAt])
}

model AuthOTP {
  id                  Int       @id @default(autoincrement())
  otpCode             Int?
  expiresAt           DateTime?
  lastOtpSentAt       DateTime?
  resendCount         Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?
  otpFor              OTPFor    @default(VERIFICATION)
  resetToken          String?
  userId              Int       @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CandidateProfile {
  id                  Int                   @id @default(autoincrement())
  fullName            String
  summary             String
  gender              Gender
  phone               String                @unique
  cv                  String?
  birthDate           DateTime              @db.Date
  address             String
  openToWork          Boolean               @default(false)
  status              Boolean               @default(true)
  userId              Int                   @unique
  Apply               Apply[]
  CandidateEducation  CandidateEducation[]
  CandidateExperience CandidateExperience[]
  CandidateLanguage   CandidateLanguage[]
  user                User                  @relation(fields: [userId], references: [id])
  CandidateSkill      CandidateSkill[]
  chats               Chat[]
  saveJobs            SaveJob[]
}

model Language {
  name              String              @id
  CandidateLanguage CandidateLanguage[]
}

model CandidateLanguage {
  level              Level            @default(BASIC)
  candidateProfileId Int
  languageName       String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  language           Language         @relation(fields: [languageName], references: [name])

  @@unique([candidateProfileId, languageName])
}

model Education {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique
  map                String
  CandidateEducation CandidateEducation[]
}

model CandidateEducation {
  id                 Int              @id @default(autoincrement())
  major              String
  degree             Degree           @default(BACHELOR)
  yearStart          Int
  yearEnd            Int
  candidateProfileId Int
  educationId        Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  education          Education        @relation(fields: [educationId], references: [id])
}

model Skill {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  CandidateSkill CandidateSkill[]
  JobSkill       JobSkill[]
}

model CandidateSkill {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  skillId            Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  skill              Skill            @relation(fields: [skillId], references: [id])

  @@unique([candidateProfileId, skillId])
}

model CandidateExperience {
  id                 Int              @id @default(autoincrement())
  companyName        String
  department         String
  startDate          DateTime         @db.Date
  endDate            DateTime?        @db.Date
  position           String
  description        String
  currentlyWorking   Boolean          @default(false)
  workPlace          WorkPlace        @default(ONSITE)
  location           String
  candidateProfileId Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])

  @@unique([id, candidateProfileId])
}

//establishDate => optional
model Company {
  id              Int               @id @default(autoincrement())
  name            String
  description     String
  location        String
  address         String?
  mapLink         String?
  websiteUrl      String?
  teamSizeLabel   TeamSizeRange?
  totalEmployees  Int
  establishedDate DateTime
  isApproved      Boolean           @default(false)
  views           Int?              @default(0)
  userId          Int
  applies         Apply[]
  chats           Chat[]
  user            User              @relation(fields: [userId], references: [id])
  CompanyImage    CompanyImage[]
  CompanyIndustry CompanyIndustry[]
  Job             Job[]
}

model CompanyImage {
  id        Int     @id @default(autoincrement())
  imageUrl  String
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
}

model Industry {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  CompanyIndustry CompanyIndustry[]
}

model CompanyIndustry {
  id         Int      @id @default(autoincrement())
  companyId  Int
  industryId Int
  company    Company  @relation(fields: [companyId], references: [id])
  industry   Industry @relation(fields: [industryId], references: [id])

  @@unique([companyId, industryId])
}

model JobRole {
  id   Int    @id @default(autoincrement())
  name String @unique
  Job  Job[]
}

model Job {
  id                  Int          @id @default(autoincrement())
  title               String
  description         String
  responsibilities    String
  requirements        String
  location            String
  workplace           WorkPlace
  status              JobStatus
  salaryMin           Int
  salaryMax           Int
  postedAt            DateTime     @default(now()) @db.Timestamp(6)
  applicationDeadline DateTime     @db.Date
  updateAt            DateTime?    @updatedAt
  totalview           Int          @default(0)
  isDeleted           Boolean      @default(false)
  companyId           Int
  postById            Int
  jobRoleId           Int
  Apply               Apply[]
  company             Company      @relation(fields: [companyId], references: [id])
  jobRole             JobRole      @relation(fields: [jobRoleId], references: [id])
  postBy              User         @relation(fields: [postById], references: [id])
  JobBenefit          JobBenefit[]
  JobSkill            JobSkill[]
  saveJobs            SaveJob[]
}

model SaveJob {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int
  createdAt          DateTime         @default(now())
  jobId              Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  job                Job              @relation(fields: [jobId], references: [id])

  @@unique([candidateProfileId, jobId])
}

model JobSkill {
  jobId   Int
  skillId Int
  job     Job   @relation(fields: [jobId], references: [id])
  skill   Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
}

model Benefit {
  name       String       @id
  JobBenefit JobBenefit[]
}

model JobBenefit {
  jobId       Int
  benefitName String
  benefit     Benefit @relation(fields: [benefitName], references: [name])
  job         Job     @relation(fields: [jobId], references: [id])

  @@id([jobId, benefitName])
}

model Apply {
  id                 Int              @id @default(autoincrement())
  applyDate          DateTime         @default(now()) @db.Timestamp(6)
  status             ApplyStatus      @default(PENDING)
  companyId          Int
  candidateProfileId Int
  jobId              Int
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  company            Company          @relation(fields: [companyId], references: [id])
  job                Job              @relation(fields: [jobId], references: [id])

  @@unique([candidateProfileId, jobId])
}

model Package {
  id               Int                @id @default(autoincrement())
  planId           String
  label            String
  price            Float
  jobPostLimit     Int
  isActive         Boolean            @default(true)
  RecruiterPackage RecruiterPackage[]
  Subscription     Subscription[]
}

model CheckLimitForRecruiter {
  id          Int  @id @default(autoincrement())
  jobCount    Int  @default(0)
  recruiterId Int  @unique
  recruiter   User @relation(fields: [recruiterId], references: [id])
}

model RecruiterPackage {
  id                     Int                    @id @default(autoincrement())
  startDate              DateTime               @default(now())
  endDate                DateTime?              @db.Date
  razorpaySubscriptionId String?                @unique
  status                 RecruiterPackageStatus
  billingCycleCount      Int?                   @default(0)
  userId                 Int                    @unique
  packageId              Int
  package                Package                @relation(fields: [packageId], references: [id])
  User                   User                   @relation(fields: [userId], references: [id])
}

model Subscription {
  id                     Int                @id @default(autoincrement())
  razorpaySubscriptionId String             @unique
  razorpayPlanId         String
  status                 SubscriptionStatus
  startAt                DateTime?
  endAt                  DateTime?
  nextPayment            DateTime?
  totalCount             Int?
  paidCount              Int?
  currency               String             @default("INR")
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  recruiterId            Int
  packageId              Int
  package                Package            @relation(fields: [packageId], references: [id])
  recruiter              User               @relation(fields: [recruiterId], references: [id])
}

model PaymentHistory {
  id                     Int           @id @default(autoincrement())
  razorpayPaymentId      String?       @unique
  razorpaySubscriptionId String?
  amount                 Float
  currency               String        @default("INR")
  status                 PaymentStatus
  paymentMethod          String?
  failureReason          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  userId                 Int
  user                   User          @relation(fields: [userId], references: [id])
}

model Chat {
  id                 Int    @id @default(autoincrement())
  candidateProfileId Int
  companyId          Int
  chatRoomId         String @unique

  companyUnreadCount   Int @default(0)
  candidateUnreadCount Int @default(0)

  lastMessage   String?
  lastMessageAt DateTime @default(now())

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])
  company          Company          @relation(fields: [companyId], references: [id])
  messages         Message[]

  // @@index([lastMessageAt, id])
  @@unique([lastMessageAt, id])
  @@unique([companyId, candidateProfileId])
}

model Message {
  id         Int      @id @default(autoincrement())
  chatId     Int
  senderId   Int
  receiverId Int
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id])

  // @@index([chatId, receiverId, isRead])
  @@unique([createdAt, id])
  @@index([chatId, createdAt])
  @@index([chatId, isRead])
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum AuthType {
  EMAIL
  OAUTH
}

enum OTPFor {
  VERIFICATION
  FORGOT_PASSWORD
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Level {
  NATIVE
  FLUENT
  BASIC
}

enum Degree {
  BACHELOR
  MASTER
  PHD
}

enum WorkPlace {
  ONSITE
  REMOTE
  HYBRID
}

enum TeamSizeRange {
  ZERO_TO_ONE
  TWO_TO_TEN
  ELEVEN_TO_FIFTY
  FIFTY_ONE_TO_TWO_HUNDRED
  TWO_HUNDRED_ONE_TO_FIVE_HUNDRED
  FIVE_HUNDRED_ONE_TO_ONE_THOUSAND
  OVER_ONE_THOUSAND
}

enum JobStatus {
  PENDING
  ACTIVE
  EXPIRED
  REJECTED
}

enum ApplyStatus {
  PENDING
  VIEWED
  SELECTED
  NOTSELECT
  INTOUCH
}

enum RecruiterPackageStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  CREATED
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
  HALTED
}

enum PaymentStatus {
  SUCCESSFUL
  FAILED
  REFUNDED
}
