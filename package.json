{
  "name": "job-portal",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "dotenv -e .env.dev -- nodemon",
    "build": "rimraf ./dist && tsc && tsc-alias",
    "start": "node dist/index.js",
    "migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:test:reset": "dotenv -e .env.test -- prisma migrate reset --force",
    "test:setup": "dotenv -e .env.test -- prisma migrate reset --force && dotenv -e .env.test -- ts-node prisma/seed-test.ts",
    "test": "dotenv -e .env.test -- jest --runInBand",
    "test:run": "npm run test:setup && npm run test",
    "test:watch": "dotenv -e .env.test -- jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "Tirth Rojara",
